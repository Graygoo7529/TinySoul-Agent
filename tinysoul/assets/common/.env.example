# Inference models (Proxy)
OPENCODE_API_KEY=
ORCA_API_KEY=
SUBLYX_API_KEY=
TOKEN_ADVANT_API_KEY=
WENRUGOU_API_KEY=

# Dedicated models: embedding
GLM_EMBEDDING_API_KEY=

