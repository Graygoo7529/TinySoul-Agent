# Outbound proxy defaults are configured in configs/infra/network.toml.

# Backend Endpoint (optional; defaults to 127.0.0.1:1430)
# Use 0.0.0.0 on a trusted remote host, then connect from the client using
# that host's reachable IP address and the token in .auth.
TINYSOUL_ENDPOINT__BIND_HOST=127.0.0.1
TINYSOUL_ENDPOINT__PORT=1430
