{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "ReflectionOriginResponse": {
      "additionalProperties": true,
      "properties": {
        "trigger": {
          "title": "Trigger",
          "type": "string"
        },
        "target_day": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Day"
        },
        "instructions_excerpt": {
          "title": "Instructions Excerpt",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        }
      },
      "required": [
        "trigger",
        "target_day",
        "instructions_excerpt",
        "truncated"
      ],
      "title": "ReflectionOriginResponse",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "turn_id": {
      "title": "Turn Id",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "state": {
      "title": "State",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "generation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Id"
    },
    "active_day": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Day"
    },
    "accepted_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted At"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "reflection": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReflectionOriginResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cancel_requested": {
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "wait_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Wait Reason"
    },
    "question": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonObject"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonObject"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonObject"
        },
        {
          "type": "null"
        }
      ]
    },
    "jobs": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Jobs",
      "type": "array"
    }
  },
  "required": [
    "turn_id",
    "kind",
    "state",
    "cancel_requested",
    "wait_reason",
    "question",
    "budget_request",
    "result",
    "jobs"
  ],
  "title": "TurnResponse",
  "type": "object"
}
