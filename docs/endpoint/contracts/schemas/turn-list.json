{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ReflectionOriginResponse": {
      "additionalProperties": true,
      "properties": {
        "trigger": {
          "title": "Trigger",
          "type": "string"
        },
        "target_day": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Day"
        },
        "instructions_excerpt": {
          "title": "Instructions Excerpt",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        }
      },
      "required": [
        "trigger",
        "target_day",
        "instructions_excerpt",
        "truncated"
      ],
      "title": "ReflectionOriginResponse",
      "type": "object"
    },
    "TurnSummaryResponse": {
      "additionalProperties": true,
      "properties": {
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "generation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Id"
        },
        "active_day": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Day"
        },
        "accepted_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted At"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "reflection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReflectionOriginResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "turn_id",
        "kind",
        "state"
      ],
      "title": "TurnSummaryResponse",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/TurnSummaryResponse"
      },
      "title": "Items",
      "type": "array"
    },
    "completed_limit": {
      "title": "Completed Limit",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "completed_limit"
  ],
  "title": "TurnListResponse",
  "type": "object"
}
