{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "included_scopes": {
      "items": {
        "type": "string"
      },
      "title": "Included Scopes",
      "type": "array"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonObject"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "active_match": {
      "title": "Active Match",
      "type": "boolean"
    },
    "saved_match": {
      "title": "Saved Match",
      "type": "boolean"
    },
    "validation_issues": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Validation Issues",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "included_scopes",
    "active_match",
    "saved_match",
    "validation_issues",
    "created_at",
    "updated_at"
  ],
  "title": "PresetResponse",
  "type": "object"
}
