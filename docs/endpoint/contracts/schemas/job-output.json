{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    }
  },
  "additionalProperties": true,
  "properties": {
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Items",
      "type": "array"
    },
    "next_continuation": {
      "title": "Next Continuation",
      "type": "string"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    },
    "result_locators": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Result Locators",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "items",
    "next_continuation",
    "truncated",
    "result_locators"
  ],
  "title": "JobOutputResponse",
  "type": "object"
}
