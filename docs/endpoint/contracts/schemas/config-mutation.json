{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    }
  },
  "additionalProperties": true,
  "properties": {
    "state": {
      "enum": [
        "saved",
        "active"
      ],
      "title": "State",
      "type": "string"
    },
    "generation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Id"
    },
    "pending_reload": {
      "title": "Pending Reload",
      "type": "boolean"
    },
    "changed_fields": {
      "items": {
        "type": "string"
      },
      "title": "Changed Fields",
      "type": "array"
    },
    "changed_sources": {
      "items": {
        "type": "string"
      },
      "title": "Changed Sources",
      "type": "array"
    },
    "matching_presets": {
      "items": {
        "type": "string"
      },
      "title": "Matching Presets",
      "type": "array"
    },
    "cleanup_diagnostics": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Cleanup Diagnostics",
      "type": "array"
    }
  },
  "required": [
    "state",
    "pending_reload",
    "changed_fields",
    "changed_sources"
  ],
  "title": "ConfigMutationResponse",
  "type": "object"
}
