{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    }
  },
  "additionalProperties": true,
  "properties": {
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "jobs": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Jobs",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "jobs"
  ],
  "title": "JobListResponse",
  "type": "object"
}
